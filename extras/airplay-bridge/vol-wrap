#!/usr/bin/env bash
# vol-wrap: route volume keys smartly.
#
# Governance ("which device do the volume keys drive?") has three modes:
#   auto (default) - follow the active route:
#       OwnTone playing AND >=1 AirPlay/Chromecast output selected -> owntone API
#           * single output : simple +/- on that output
#           * multi-room    : ratio-anchored scaling (Option C) using the
#                             baseline captured by `speaker multi`
#       otherwise -> pactl on the local sink
#   local   - keys always drive the local sink, even mid-AirPlay-session
#             (browser / notification / meeting audio needs a knob too)
#   airplay - keys always drive the selected OwnTone outputs, playing or not
#
# The override is a runtime pin (gone after reboot), and `speaker` clears it
# on every route change: picking a route is a statement of intent, so the
# keys snap back to following it.
#
# Usage: vol-wrap {up|down|mute}
#        vol-wrap target [auto|local|airplay|cycle|status]

set -u -o pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mpd-owntone-bridge/config.env"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/mpd-owntone-bridge/state.json"
MUTE_FILE="${XDG_RUNTIME_DIR:-/tmp}/vol-wrap.muted.json"
TARGET_FILE="${XDG_RUNTIME_DIR:-/tmp}/vol-wrap.target"

[[ -f "$CONFIG" ]] || { echo "missing config: $CONFIG" >&2; exit 1; }
# shellcheck source=/dev/null
. "$CONFIG"

CURL=(command curl --silent --max-time 0.4)

owntone_selected_ids() {
  "${CURL[@]}" "${OWNTONE_API}/outputs" 2>/dev/null \
    | jq -r '.outputs[] | select(.selected==true and ((.type | startswith("AirPlay")) or (.type | startswith("Chromecast")))) | .id'
}

owntone_active_ids() {
  local resp
  resp=$("${CURL[@]}" "${OWNTONE_API}/player" 2>/dev/null) || return 1
  [[ "$(jq -r .state <<< "$resp" 2>/dev/null)" == "play" ]] || return 1
  owntone_selected_ids
}

owntone_get_volume() {
  "${CURL[@]}" "${OWNTONE_API}/outputs/$1" | jq -r '.volume // 0'
}

owntone_set_volume() {
  local v="$2"
  (( v < 0 )) && v=0
  (( v > 100 )) && v=100
  "${CURL[@]}" -X PUT "${OWNTONE_API}/outputs/$1" \
    -H 'Content-Type: application/json' \
    -d "{\"volume\": $v}" >/dev/null
}

state_read() { [[ -f "$STATE" ]] && cat "$STATE" || echo '{}'; }

# waybar's custom/volume module polls on an interval; poke it so the number
# moves on the same keypress instead of up to one poll later. No-op when
# waybar isn't running.
waybar_refresh() { pkill -RTMIN+9 waybar 2>/dev/null || true; }

# -------- local sink path --------

# The owntone-bridge null sink is PCM transport for the AirPlay FIFO, not a
# playback device. Its slider must never receive volume keys: with
# monitor.channel-volumes=true it was a hidden second attenuator in front of
# OwnTone, and this exact fallback branch walked it down to 15% (-49 dB)
# whenever the bridge happened to be the default sink. Resolve the real
# local sink instead; if the default IS the bridge, fall back to the
# configured laptop sink or do nothing at all.
local_sink() {
  local sink
  sink=$(pactl get-default-sink 2>/dev/null)
  if [[ -z "$sink" || "$sink" == "owntone-bridge" ]]; then
    sink="${PIPEWIRE_LAPTOP_SINK:-}"
  fi
  [[ -n "$sink" ]] && echo "$sink"
}

local_action() {
  local sink
  sink=$(local_sink) || return 0
  case "$1" in
    up)   pactl set-sink-volume "$sink" "+${VOL_STEP_PCT}%" ;;
    down) pactl set-sink-volume "$sink" "-${VOL_STEP_PCT}%" ;;
    mute) pactl set-sink-mute   "$sink" toggle ;;
  esac
}

# -------- governance target (auto / local / airplay) --------

target_get() {
  local t
  t=$(cat "$TARGET_FILE" 2>/dev/null)
  case "$t" in local|airplay) echo "$t" ;; *) echo auto ;; esac
}

target_set() {
  case "$1" in
    auto)          rm -f "$TARGET_FILE" ;;
    local|airplay) echo "$1" > "$TARGET_FILE" ;;
  esac
  waybar_refresh
}

target_cycle() {
  local cur next
  cur=$(target_get)
  case "$cur" in
    auto)
      next=local ;;
    local)
      # Pinning to airplay is pointless with no airplay output selected;
      # collapse the cycle to auto <-> local in that case.
      if [[ -n "$(owntone_selected_ids)" ]]; then next=airplay; else next=auto; fi
      ;;
    *)
      next=auto ;;
  esac
  target_set "$next"
  notify-send -t 1500 "volume keys" "target: $next" 2>/dev/null || true
  echo "$next"
}

# -------- single-speaker paths --------

single_change() {
  local id="$1" delta="$2" cur new
  cur=$(owntone_get_volume "$id"); new=$(( cur + delta ))
  owntone_set_volume "$id" "$new"
}

single_mute_toggle() {
  local id="$1" cur
  cur=$(owntone_get_volume "$id")
  if (( cur > 0 )); then
    jq -n --arg id "$id" --argjson v "$cur" '{($id):$v}' > "$MUTE_FILE"
    owntone_set_volume "$id" 0
  else
    local saved
    saved=$(jq -r --arg id "$id" '.[$id] // 40' "$MUTE_FILE" 2>/dev/null)
    owntone_set_volume "$id" "$saved"
  fi
}

# -------- multi-room (Option C: ratio-anchored) --------
#
# Baseline is captured by `speaker multi` at entry time. On +/-, we pick the
# loudest-baseline speaker as the "lead", bump it by the step, then scale all
# other speakers by the same ratio (lead_new / lead_baseline). Preserves the
# relative mix you tuned per-speaker.

multi_change() {
  local delta="$1"; shift
  local baseline
  baseline=$(state_read | jq '.multi_baseline // empty')
  if [[ -z "$baseline" || "$baseline" == "null" ]]; then
    # No baseline captured; flat +/- on each so the user still gets a response.
    local id
    for id in "$@"; do single_change "$id" "$delta"; done
    return
  fi

  local lead_id lead_base lead_cur lead_new scale
  lead_id=$(jq -r 'to_entries | max_by(.value) | .key' <<< "$baseline")
  lead_base=$(jq -r --arg id "$lead_id" '.[$id]' <<< "$baseline")
  lead_cur=$(owntone_get_volume "$lead_id")
  lead_new=$(( lead_cur + delta ))
  (( lead_new < 0 )) && lead_new=0
  (( lead_new > 100 )) && lead_new=100
  scale=$(awk -v a="$lead_new" -v b="$lead_base" 'BEGIN{ if (b==0) print 1; else print a/b }')

  local id base new
  for id in "$@"; do
    base=$(jq -r --arg id "$id" '.[$id] // empty' <<< "$baseline")
    [[ -z "$base" ]] && base=40
    new=$(awk -v b="$base" -v s="$scale" 'BEGIN{ printf "%d", b*s + 0.5 }')
    owntone_set_volume "$id" "$new"
  done
}

multi_mute_toggle() {
  local -a ids=("$@")
  local any_audible=0 id cur snap='{}'
  for id in "${ids[@]}"; do
    cur=$(owntone_get_volume "$id")
    snap=$(jq --arg id "$id" --argjson v "$cur" '.[$id]=$v' <<< "$snap")
    (( cur > 0 )) && any_audible=1
  done
  if (( any_audible == 1 )); then
    echo "$snap" > "$MUTE_FILE"
    for id in "${ids[@]}"; do owntone_set_volume "$id" 0; done
  else
    local saved='{}' v
    [[ -f "$MUTE_FILE" ]] && saved=$(cat "$MUTE_FILE")
    for id in "${ids[@]}"; do
      v=$(jq -r --arg id "$id" '.[$id] // 40' <<< "$saved")
      owntone_set_volume "$id" "$v"
    done
  fi
}

# -------- dispatch --------

action="${1:-}"

if [[ "$action" == "target" ]]; then
  sub="${2:-status}"
  case "$sub" in
    auto|local|airplay) target_set "$sub" ;;
    cycle)              target_cycle >/dev/null ;;
    status)             target_get ;;
    *) echo "usage: vol-wrap target {auto|local|airplay|cycle|status}" >&2; exit 2 ;;
  esac
  exit 0
fi

case "$action" in
  up|down|mute) ;;
  *) echo "usage: vol-wrap {up|down|mute} | vol-wrap target {auto|local|airplay|cycle|status}" >&2; exit 2 ;;
esac

# Pick the governed outputs. An airplay pin uses the selected outputs even
# when OwnTone is paused (the user asked for that knob explicitly); auto
# additionally requires OwnTone to be playing, matching the route heuristic.
mode=$(target_get)
ACTIVE=()
case "$mode" in
  local)   ;; # never consult owntone; keys are pinned to the local sink
  airplay) mapfile -t ACTIVE < <(owntone_selected_ids || true) ;;
  auto)    mapfile -t ACTIVE < <(owntone_active_ids   || true) ;;
esac

if (( ${#ACTIVE[@]} == 0 )); then
  local_action "$action"
  waybar_refresh
  exit 0
fi

if (( ${#ACTIVE[@]} == 1 )); then
  case "$action" in
    up)   single_change "${ACTIVE[0]}" "+${VOL_STEP_PCT}" ;;
    down) single_change "${ACTIVE[0]}" "-${VOL_STEP_PCT}" ;;
    mute) single_mute_toggle "${ACTIVE[0]}" ;;
  esac
  waybar_refresh
  exit 0
fi

case "$action" in
  up)   multi_change "+${VOL_STEP_PCT}" "${ACTIVE[@]}" ;;
  down) multi_change "-${VOL_STEP_PCT}" "${ACTIVE[@]}" ;;
  mute) multi_mute_toggle            "${ACTIVE[@]}" ;;
esac
waybar_refresh
