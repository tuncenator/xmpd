#!/usr/bin/env bash
# apply-single-knob: collapse the AirPlay volume chain to ONE knob.
#
# Before: two attenuators are stacked in front of the receiver -
#   1. the owntone-bridge null sink's volume slider (because the sink was
#      created with monitor.channel-volumes=true, its slider scales the PCM
#      that the padder captures and feeds to OwnTone), and
#   2. the receiver's own AirPlay volume (OwnTone's per-output volume).
# Attenuator 1 is invisible, gets walked down by accident, and degrades the
# signal (S16 PCM attenuated ~49 dB keeps ~5 effective bits). After this
# script, the monitor always carries unity PCM and OwnTone's per-output
# volume is the only knob - exactly what every other AirPlay sender does.
#
# LOUDNESS WARNING - read before running:
# Removing attenuator 1 is a step UP of whatever the slider currently sits
# at (e.g. 15% = +49.4 dB at the receiver's PCM input). AirPlay volume only
# reaches down to about -30 dB before hard mute, so if you are listening at
# a combined level below that floor (late-night levels), NO OwnTone volume
# can reproduce it after the switch - the receiver WILL get audibly louder
# until you turn it down. Run this when a burst of moderate volume is
# acceptable, not in the middle of the night. The script pre-drops the
# AirPlay volume to --volume (default 10) before touching anything, so the
# burst is bounded to "10% of the receiver's range".
#
# Usage: apply-single-knob [--volume N] [--yes]

set -u -o pipefail

# pactl prints dB with the locale's decimal separator; jq needs a dot.
export LC_ALL=C

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mpd-owntone-bridge/config.env"
PW_NULLSINK="${HOME}/.config/pipewire/pipewire.conf.d/30-owntone-bridge.conf"

[[ -f "$CONFIG" ]] || { echo "missing config: $CONFIG" >&2; exit 1; }
# shellcheck source=/dev/null
. "$CONFIG"

CURL=(command curl --silent --max-time 2)

info() { printf '\033[0;32m[single-knob]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[single-knob]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[0;31m[single-knob]\033[0m %s\n' "$*" >&2; exit 1; }

SAFE_VOL=10
ASSUME_YES=0
while (( $# )); do
  case "$1" in
    --volume) SAFE_VOL="${2:?--volume needs a value}"; shift 2 ;;
    --yes)    ASSUME_YES=1; shift ;;
    *) err "unknown arg: $1 (usage: apply-single-knob [--volume N] [--yes])" ;;
  esac
done
[[ "$SAFE_VOL" =~ ^[0-9]+$ ]] && (( SAFE_VOL >= 1 && SAFE_VOL <= 50 )) \
  || err "--volume must be 1..50 (it is the receiver volume right after the switch)"

# -------- current state --------

bridge_line=$(pactl get-sink-volume owntone-bridge 2>/dev/null) \
  || err "owntone-bridge sink not found; is the bridge installed?"
bridge_pct=$(sed -n 's/.*\/ *\([0-9]\+\)% .*/\1/p;q' <<< "$bridge_line")
bridge_db=$(sed -n 's/.*\/ *\(-\?[0-9.,]\+\) dB.*/\1/p;q' <<< "$bridge_line")

cv=$(pactl list sinks 2>/dev/null | awk '
  /^\tName: /                                { inb = ($2 == "owntone-bridge") }
  inb && /monitor\.channel-volumes/          { gsub(/"/,"",$3); print $3; exit }')

selected=$("${CURL[@]}" "${OWNTONE_API}/outputs" \
  | jq -c '[.outputs[] | select(.selected==true and ((.type|startswith("AirPlay")) or (.type|startswith("Chromecast")))) | {id, name, volume}]') \
  || err "owntone API unreachable at ${OWNTONE_API}"
was_playing=0
[[ "$("${CURL[@]}" "${OWNTONE_API}/player" | jq -r .state)" == "play" ]] && was_playing=1

info "current bridge sink gain : ${bridge_pct}% (${bridge_db} dB), monitor.channel-volumes=${cv:-?}"
info "selected airplay outputs : $(jq -r 'map("\(.name)@\(.volume)") | join(", ") // "none"' <<< "$selected")"

if [[ "$cv" == "false" ]]; then
  info "monitor.channel-volumes is already false - nothing to migrate."
  exit 0
fi

# The arithmetic, so the level change is explicit and not a surprise:
# net attenuation today = bridge gain + AirPlay volume mapping.
# OwnTone (29.2, outputs/airplay.c airplay_volume_from_pct) maps volume V
# (0..100) to -30 + 0.3*V dB with the default max_volume=11; the floor at
# V=0 is -30 dB, not silence.
jq -r --arg bdb "$bridge_db" '.[] |
  "  \(.name): today = \($bdb) dB (bridge) + \(-30 + 0.3*.volume | . * 10 | round / 10) dB (AirPlay@\(.volume)) = \((($bdb|tonumber) + -30 + 0.3*.volume) * 10 | round / 10) dB relative to unity PCM"' \
  <<< "$selected"
info "after the switch the bridge term becomes 0 dB and the AirPlay term is"
info "the only knob; its floor is -30 dB (even at volume 0). Receiver volume"
info "will be pre-set to ${SAFE_VOL} ($(awk -v v="$SAFE_VOL" 'BEGIN{printf "%.1f", -30+0.3*v}') dB) before the switch."

if (( ! ASSUME_YES )); then
  printf '\033[1;33m[single-knob]\033[0m proceed? this WILL be audibly louder than late-night levels [y/N] '
  read -r reply
  [[ "$reply" == y || "$reply" == Y ]] || { info "aborted."; exit 0; }
fi

# -------- 1. pre-drop the receiver volume (bounds the loudness step) --------

while read -r id; do
  [[ -z "$id" ]] && continue
  info "setting owntone output $id volume -> ${SAFE_VOL}"
  "${CURL[@]}" -X PUT "${OWNTONE_API}/outputs/$id" \
    -H 'Content-Type: application/json' -d "{\"volume\": ${SAFE_VOL}}" >/dev/null
done < <(jq -r '.[].id' <<< "$selected")

# -------- 2. rewrite the null-sink drop-in --------

info "rewriting $PW_NULLSINK (monitor.channel-volumes -> false)"
[[ -f "$PW_NULLSINK" ]] && cp "$PW_NULLSINK" "${PW_NULLSINK}.pre-single-knob"
sed -E -i 's/(monitor\.channel-volumes[[:space:]]*=[[:space:]]*)true/\1false/' "$PW_NULLSINK"
grep -q 'monitor.channel-volumes.*false' "$PW_NULLSINK" \
  || err "failed to flip monitor.channel-volumes in $PW_NULLSINK"

# -------- 3. restart the stack (recreates the sink with the new prop) ------

info "restarting pipewire + pipewire-pulse + wireplumber"
systemctl --user restart pipewire pipewire-pulse wireplumber
sleep 2
systemctl --user restart mpd-owntone-padder
sleep 1

# -------- 4. neutralize the now-inert slider ------------------------------

# The slider no longer touches the monitor, but pavucontrol still shows it
# and WirePlumber persists it; park it at unity so nothing ever looks capped.
pactl set-sink-volume owntone-bridge 100% 2>/dev/null \
  || warn "could not set bridge slider to 100% (sink not up yet?)"

# -------- 5. re-establish the airplay route -------------------------------

ids=$(jq -r '.[].id' <<< "$selected")
if [[ -n "$ids" ]]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # speaker re-selects the outputs, restarts owntone playback if MPD is
  # playing, and re-nudges the metadata bridge into the fresh RTSP session.
  # shellcheck disable=SC2086
  "$SELF_DIR/speaker" multi $ids || warn "speaker re-route reported a problem; check 'speaker status'"
  (( was_playing )) && "${CURL[@]}" -X PUT "${OWNTONE_API}/player/play" >/dev/null
fi

# -------- 6. verify --------------------------------------------------------

cv=$(pactl list sinks 2>/dev/null | awk '
  /^\tName: /                                { inb = ($2 == "owntone-bridge") }
  inb && /monitor\.channel-volumes/          { gsub(/"/,"",$3); print $3; exit }')
[[ "$cv" == "false" ]] && info "verified: monitor.channel-volumes=false" \
                       || warn "monitor.channel-volumes reads '${cv:-unset}' - check $PW_NULLSINK"
if pw-link -l 2>/dev/null | grep -A1 'owntone-bridge:monitor_FL' | grep -q 'mpd-owntone-padder'; then
  info "verified: padder is linked to owntone-bridge.monitor"
else
  warn "padder link not found; run: systemctl --user restart mpd-owntone-padder"
fi

info "done. OwnTone's per-output volume is now the only knob (keys: vol-wrap)."
info "receiver is at ${SAFE_VOL}; step up with the volume keys to taste."
