#!/usr/bin/env bash
# xmpd-history - Interactive fzf-based play history browser for xmpd.
#
# Single-mode design (no Search/Browse split). Local DB query only; no
# network call blocks the UI.
#
# Keybindings:
#   enter      Play selected track (closes history)
#   ctrl-q     Queue selected track (stays open)
#   ctrl-r     Start radio from selected track (closes history)
#   ctrl-l     Toggle like/unlike for selected track (stays open)
#   ctrl-t     Toggle time/count mode
#   tab        Toggle multi-select on current line
#   ctrl-a     Queue all selected tracks (closes history)
#   ctrl-p     Clear playlist and play all selected (closes history)
#   esc        Quit
#
# Requires: fzf >= 0.36.0, xmpctl (in PATH or sibling in bin/)

set -euo pipefail

# Resolve xmpctl path: prefer sibling in same bin/ directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${SCRIPT_DIR}/xmpctl" ]]; then
    XMPCTL="${SCRIPT_DIR}/xmpctl"
elif command -v xmpctl &>/dev/null; then
    XMPCTL="xmpctl"
else
    echo "Error: xmpctl not found" >&2
    exit 1
fi

# Check fzf is available
if ! command -v fzf &>/dev/null; then
    echo "Error: fzf is required but not installed" >&2
    echo "Install with: pacman -S fzf (or your package manager)" >&2
    exit 1
fi

# Check if xmpd daemon is running
SOCKET_PATH="${HOME}/.config/xmpd/sync_socket"
if [[ ! -S "${SOCKET_PATH}" ]]; then
    echo "Error: xmpd daemon is not running" >&2
    echo "Start the daemon with: systemctl --user start xmpd" >&2
    exit 1
fi

# ANSI colors for header
TIDAL_COLOR=$'\033[38;2;115;218;202m'
YT_COLOR=$'\033[38;2;247;118;142m'
RESET=$'\033[0m'
DIM=$'\033[2m'

# Temp file for mode toggle (time <-> count)
MODE_FILE="${XMPD_HISTORY_MODE_FILE:-/tmp/xmpd-history-mode-$$}"
trap 'rm -f "${MODE_FILE}"' EXIT
printf 'time' > "${MODE_FILE}"

# Reload command. $(cat ${MODE_FILE}) is deferred to fzf's reload subshell.
RELOAD_CMD="${XMPCTL} history-json --mode \$(cat ${MODE_FILE}) --since 30d --format fzf"

# ctrl-t toggle: flip the mode file then reload
TOGGLE_TRANSFORM="execute-silent(if [[ \$(cat ${MODE_FILE}) == 'time' ]]; then echo count > ${MODE_FILE}; else echo time > ${MODE_FILE}; fi)+reload(${RELOAD_CMD})"

# Header legend
HEADER="${TIDAL_COLOR}[TD]${RESET} Tidal  ${YT_COLOR}[YT]${RESET} YouTube ${DIM}| enter=play  ctrl-q=queue  ctrl-r=radio  ctrl-l=like  tab=select  ctrl-a=queue-all  ctrl-p=play-all  ctrl-t=mode  esc=back${RESET}"

# Launch fzf
FZF_OUTPUT=$(
    fzf --ansi \
        --multi \
        --delimiter=$'\t' \
        --with-nth=3.. \
        --tabstop=8 \
        --bind "start:reload(${RELOAD_CMD})" \
        --bind "ctrl-t:${TOGGLE_TRANSFORM}" \
        --bind "ctrl-q:execute-silent([ -n {2} ] && ${XMPCTL} queue {1} {2})" \
        --bind "ctrl-r:execute-silent([ -n {2} ] && ${XMPCTL} radio --provider {1} --track-id {2} --apply)+abort" \
        --bind "ctrl-l:execute-silent([ -n {2} ] && ${XMPCTL} like-toggle {1} {2})" \
        --bind "tab:toggle" \
        --bind "enter:execute-silent([ -n {2} ] && ${XMPCTL} play {1} {2})+abort" \
        --header="${HEADER}" \
        --prompt="History: " \
        --pointer=">" \
        --no-info \
        --layout=reverse \
        --margin=1,2 \
        --no-scrollbar \
        --color='bg+:#1a1b26,pointer:#f7768e' \
        --expect='ctrl-a,ctrl-p' \
    2>/dev/null
) || exit 0

# Parse fzf --expect output.
# First line is the triggering key (ctrl-a or ctrl-p); remaining lines are selected.
TRIGGER_KEY=$(echo "${FZF_OUTPUT}" | head -n1)
SELECTED_LINES=$(echo "${FZF_OUTPUT}" | tail -n+2)

if [[ -z "${SELECTED_LINES}" ]]; then
    exit 0
fi

if [[ "${TRIGGER_KEY}" == "ctrl-a" ]]; then
    # Queue all selected tracks
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        PROVIDER=$(echo "${line}" | cut -f1)
        TRACK_ID=$(echo "${line}" | cut -f2)
        "${XMPCTL}" queue "${PROVIDER}" "${TRACK_ID}"
    done <<< "${SELECTED_LINES}"

elif [[ "${TRIGGER_KEY}" == "ctrl-p" ]]; then
    # Clear playlist then add all selected tracks, then play
    MPC_CMD=("mpc")
    CONFIG_FILE="${HOME}/.config/xmpd/config.yaml"
    if [[ -f "${CONFIG_FILE}" ]]; then
        SOCKET_VAL=$(grep -E '^\s*mpd_socket_path\s*:' "${CONFIG_FILE}" 2>/dev/null \
                     | head -n1 | sed 's/.*:\s*//' | tr -d '"'"'" | tr -d ' ')
        if [[ -n "${SOCKET_VAL}" ]]; then
            MPC_CMD=("mpc" "-h" "${SOCKET_VAL}")
        fi
    fi

    "${MPC_CMD[@]}" clear
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        PROVIDER=$(echo "${line}" | cut -f1)
        TRACK_ID=$(echo "${line}" | cut -f2)
        "${XMPCTL}" queue "${PROVIDER}" "${TRACK_ID}"
    done <<< "${SELECTED_LINES}"
    "${MPC_CMD[@]}" play
fi
